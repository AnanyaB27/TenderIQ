{
  "name": "tenderiq-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build api && nest build notification-worker",
    "start:api": "nest start api",
    "start:api:dev": "nest start api --watch",
    "start:worker": "nest start notification-worker",
    "start:worker:dev": "nest start notification-worker --watch",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc -b tsconfig.json --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:tenant-isolation": "jest --testPathPattern=tenant-isolation"
  },
  "dependencies": {
    "@nestjs/common": "10.4.1",
    "@nestjs/core": "10.4.1",
    "@nestjs/platform-express": "10.4.1",
    "@nestjs/config": "3.2.3",
    "@nestjs/typeorm": "10.0.2",
    "@nestjs/swagger": "7.4.0",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "typeorm": "0.3.20",
    "pg": "8.12.0",
    "ioredis": "5.4.1",
    "class-validator": "0.14.1",
    "class-transformer": "0.5.1",
    "joi": "17.13.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.4",
    "@nestjs/schematics": "10.1.4",
    "@nestjs/testing": "10.4.1",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/node": "20.14.15",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "jest": "29.7.0",
    "prettier": "3.3.3",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "ts-jest": "29.2.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.5.4"
  }
}
